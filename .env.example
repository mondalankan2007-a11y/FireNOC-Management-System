# Copy this file to .env and fill in the values for your own machine.
# .env is listed in .gitignore and must never be committed.

# Django Application Settings
SECRET_KEY=django-insecure-firenoc-replace-with-secure-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# PostgreSQL is the database for this project. Create the database once with:
#
#     createdb firenoc_db
#
# then run: python manage.py migrate
DB_ENGINE=django.db.backends.postgresql
DB_NAME=firenoc_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Seconds to keep a database connection open for reuse (PostgreSQL only).
DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# SQLite fallback (optional)
# ---------------------------------------------------------------------------
# If PostgreSQL is not installed on your machine, comment out the PostgreSQL
# block above and uncomment the two lines below instead. The application runs
# unchanged; only this file differs.
#
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
